# ---- Copy to .env (or export these variables) ------------------------------------------------
# Where indexes and cloned repos are stored (default: ~/.codeworld, shared by the UI, CLI and MCP server)
# CODEWORLD_DATA_DIR=/absolute/path/to/data

# ---- LLM (optional). "none" = fully offline, extractive answers from the code graph ------------
# none | ollama | openai   ("openai" = any OpenAI-compatible endpoint: Groq, Gemini, OpenRouter, LM Studio, llama.cpp server ...)
CODEWORLD_LLM_PROVIDER=none
# --- Local, free, CPU:  ollama pull qwen2.5-coder:3b   (use 1.5b if you have 8 GB RAM) ---
# CODEWORLD_LLM_PROVIDER=ollama
# CODEWORLD_LLM_MODEL=qwen2.5-coder:3b
# CODEWORLD_LLM_BASE_URL=http://localhost:11434
# --- Free-tier hosted API (check the provider's current limits) ---
# CODEWORLD_LLM_PROVIDER=openai
# CODEWORLD_LLM_BASE_URL=https://api.groq.com/openai/v1
# CODEWORLD_LLM_MODEL=<model name from the provider>
# CODEWORLD_LLM_API_KEY=<your key>

# ---- Embeddings -------------------------------------------------------------------------------
# hash (default: zero downloads, CPU) | st (sentence-transformers, e.g. CodeRankEmbed) | ollama | openai
CODEWORLD_EMBED_BACKEND=hash
# CODEWORLD_EMBED_BACKEND=st
# CODEWORLD_EMBED_MODEL=nomic-ai/CodeRankEmbed
# CODEWORLD_EMBED_BACKEND=ollama
# CODEWORLD_EMBED_MODEL=nomic-embed-text

# ---- Analysis ---------------------------------------------------------------------------------
# Call-resolution level: 0 name-only | 1 scope+imports | 2 +type flow (default) | 3 +Jedi
CODEWORLD_RESOLVER_LEVEL=2
CODEWORLD_CLONE_DEPTH=1000
CODEWORLD_GIT_COMMITS=3000

# ---- Safety / limits --------------------------------------------------------------------------
CODEWORLD_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
CODEWORLD_MAX_REPO_MB=200
CODEWORLD_MAX_REPO_FILES=6000
CODEWORLD_MAX_FILE_BYTES=400000
# Let the API index a folder on the server's disk (CLI always can). Leave 0 if the API is exposed to others.
CODEWORLD_ALLOW_LOCAL=0
# Browser origins allowed to call the API in dev
CODEWORLD_CORS=http://localhost:5173,http://127.0.0.1:5173
